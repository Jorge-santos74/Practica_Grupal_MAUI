             x:Class="Practica_Grupal_MAUI.Views.ejercicio2.Ejercicio2Page"
             Title="Ejercicio2Page">
    <VerticalStackLayout Padding="30" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">

        <Label x:Name="LblContador"
               Text="10"
               FontSize="80"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Button x:Name="BtnIniciar"
