<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practica_Grupal_MAUI.Views.Ejercicio1.ejercicio1Page"
             Title="ejercicio1Page">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" HorizontalOptions="Center">

            <Label Text="Números Pares del 0 al 100"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Button Text="Generar Números"
                    Clicked="OnGenerarClicked"
                    HorizontalOptions="Center" />

            <!-- Aquí se mostrarán los resultados -->
            <Label x:Name="LblResultados"
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>