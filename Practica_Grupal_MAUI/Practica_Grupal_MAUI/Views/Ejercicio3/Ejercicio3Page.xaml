<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practica_Grupal_MAUI.Views.Ejercicio3.Ejercicio3Page"
             Title="Tablas de Multiplicar">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Tablas de Multiplicar del 1 al 10"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <Picker x:Name="PickerTabla"
                    Title="Selecciona una tabla"
                    SelectedIndexChanged="OnTablaChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Tabla del 1</x:String>
                        <x:String>Tabla del 2</x:String>
                        <x:String>Tabla del 3</x:String>
                        <x:String>Tabla del 4</x:String>
                        <x:String>Tabla del 5</x:String>
                        <x:String>Tabla del 6</x:String>
                        <x:String>Tabla del 7</x:String>
                        <x:String>Tabla del 8</x:String>
                        <x:String>Tabla del 9</x:String>
                        <x:String>Tabla del 10</x:String>
                        <x:String>Mostrar Todas</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <VerticalStackLayout x:Name="ContainerResultados" Spacing="10" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>